@page "/propertymanagement/properties"
@using Nine.Core.Entities

@inject PropertyService PropertyService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [OrganizationAuthorize("Owner", "Administrator", "PropertyManager", "User")]
@rendermode InteractiveServer


<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><span class="bi bi-house-fill" aria-hidden="true"></span> Properties</h1>
    <div class="btn-group">
        <div class="btn-group me-2" role="group">
            <button class="btn btn-outline-secondary @(viewMode == PropertyListViewMode.Grid ? "active" : "")" 
                    @onclick="() => SetViewMode(PropertyListViewMode.Grid)" title="Grid View">
                <i class="bi bi-grid-3x3-gap"></i>
            </button>
            <button class="btn btn-outline-secondary @(viewMode == PropertyListViewMode.Table ? "active" : "")" 
                    @onclick="() => SetViewMode(PropertyListViewMode.Table)" title="List View">
                <i class="bi bi-list-ul"></i>
            </button>
        </div>
        @if (showActiveTab && activeCount < maxProperties)
        {
            <button class="btn btn-primary" @onclick="CreateProperty">
                <i class="bi bi-plus-lg"></i> Add Property
            </button>
        }
    </div>
</div>
<hr />
<PropertyMetricsCard
    AvailableCount="@availableProperties"
    OccupiedCount="@occupiedProperties"
    TotalMonthlyRent="@totalMonthlyRent"
    ShowTotalProperties="false" ShowAvailableProperties="true" ShowOccupiedProperties="true" ShowTotalMonthlyRent="true" />
<hr />
<div class="d-flex align-items-center justify-content-between mb-1">
    <ul class="nav nav-tabs mb-0">
        <li class="nav-item">
            <button class="nav-link @(showActiveTab ? "active" : "")" @onclick='() => SwitchTab(true)'>
                <i class="bi bi-check-circle me-1"></i> Active
                <span class="badge bg-success ms-2">@activeCount</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(!showActiveTab ? "active" : "")" @onclick='() => SwitchTab(false)'>
                <i class="bi bi-pause-circle me-1"></i> Inactive
                <span class="badge bg-secondary ms-2">@inactiveCount</span>
            </button>
        </li>
    </ul>
    <div class="form-check form-switch ms-2">
        <input class="form-check-input" type="checkbox" id="showArchived"
               @bind="_showArchived" @bind:after="LoadProperties" />
        <label class="form-check-label text-muted" for="showArchived">Show Archived</label>
    </div>
</div>
<div class="mb-3"></div>

<PropertyListView Properties="@filteredProperties"
    ViewMode="@viewMode"
    SortColumn="@sortColumn"
    SortAscending="@sortAscending"
    StatusFilter="@statusFilter"
    AvailableCount="@availableProperties"
    OccupiedCount="@occupiedProperties"
    TotalMonthlyRent="@totalMonthlyRent"
    OnSort="HandleSort"
    OnEdit="EditProperty"
    OnView="ViewPropertyDetails"
    OnDelete="ShowDeleteModal"
    OnArchive="ShowArchiveModal"
    OnUnarchive="UnarchiveProperty"
    ShowArchived="@_showArchived"
    OnStatusFilterChanged="StatusFilterChanged"
    OnClearFilters="ClearFilters"
    OnSearchChanged="SearchChanged"
    SearchTerm="@searchTerm"
    ShowMetrics="false" />

<ActionConfirmModal
    IsVisible="@_showArchiveModal"
    Variant="warning"
    Title="Archive Property"
    Message="This record will be hidden from daily operations. You can restore it at any time."
    ConfirmText="Archive"
    Cascade="@_cascade"
    IsProcessing="@_isProcessing"
    OnConfirm="ConfirmArchive"
    OnCancel="CloseModals" />

<ActionConfirmModal
    IsVisible="@_showDeleteModal"
    Variant="danger"
    Title="Delete Property"
    Message="This action is permanent and cannot be undone. Be sure to create a backup of your data if needed."
    ConfirmText="Delete Permanently"
    Cascade="@_cascade"
    IsProcessing="@_isProcessing"
    OnConfirm="ConfirmDelete"
    OnCancel="CloseModals" />

<ActionConfirmModal
    IsVisible="@_showUnarchiveModal"
    Variant="warning"
    Title="Restore Archived Property"
    Message="This property has archived records. Choose how you would like to restore it."
    ConfirmText="Restore All"
    SecondaryConfirmText="Property Only"
    CascadeLabel="Archived records that can be restored:"
    Cascade="@_unarchiveSummary"
    IsProcessing="@_isProcessing"
    OnConfirm="ConfirmUnarchiveAll"
    OnSecondaryConfirm="ConfirmUnarchivePropertyOnly"
    OnCancel="CloseModals" />

@code {
    private List<Property> allProperties = new List<Property>();
    private List<Property> Properties = new List<Property>();
    private List<Property> filteredProperties = new List<Property>();
    private bool showActiveTab = true;
    private int activeCount => allProperties.Count(p => p.IsActive);
    private int inactiveCount => allProperties.Count(p => !p.IsActive);
    private PropertyListViewMode viewMode = PropertyListViewMode.Table;
    private string sortColumn = nameof(Property.Address);
    private bool sortAscending = true;
    private string statusFilter = string.Empty;
    private string searchTerm = string.Empty;
    private int availableProperties = 0;
    private int maxProperties = 9;
    private int occupiedProperties = 0;
    private decimal totalMonthlyRent = 0.00m;

    // Archive/Delete modal state
    private Guid _pendingId;
    private CascadeSummary? _cascade;
    private bool _showArchiveModal;
    private bool _showDeleteModal;
    private bool _showUnarchiveModal;
    private CascadeSummary? _unarchiveSummary;
    private bool _isProcessing;
    private bool _showArchived;

    protected override async Task OnInitializedAsync()
    {
        await LoadProperties();
    }

    private async Task LoadProperties()
    {
        allProperties = _showArchived
            ? await PropertyService.GetArchivedAsync()
            : await PropertyService.GetAllAsync();
        availableProperties = allProperties.Count(p => p.Status == ApplicationConstants.PropertyStatuses.Available);
        occupiedProperties = allProperties.Count(p => ApplicationConstants.PropertyStatuses.OccupiedStatuses.Contains(p.Status));
        totalMonthlyRent = allProperties.Where(p => p.IsActive).Sum(p => p.MonthlyRent);
        ApplyTab(showActiveTab);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "propertyListActiveTab");
            bool savedTab = saved != "inactive";
            if (savedTab != showActiveTab)
            {
                ApplyTab(savedTab);
                StateHasChanged();
            }
        }
    }

    private void HandleSort((string Column, bool Ascending) sortInfo)
    {
        sortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        ApplySort();
    }

    private void ApplyTab(bool active)
    {
        showActiveTab = active;
        statusFilter = string.Empty;
        searchTerm = string.Empty;
        Properties = allProperties.Where(p => p.IsActive == active).ToList();
        ApplySort();
    }

    private async Task SwitchTab(bool active)
    {
        ApplyTab(active);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "propertyListActiveTab", active ? "active" : "inactive");
    }

    private void ApplySort()
    {
        // Apply status filter first
        var propertiesToSort = string.IsNullOrEmpty(statusFilter) 
            ? Properties 
            : Properties.Where(p => p.Status == statusFilter).ToList();
        
        // Then apply sorting
        filteredProperties = sortColumn switch
        {
            nameof(Property.Address) => sortAscending 
                ? propertiesToSort.OrderBy(p => p.Address).ToList()
                : propertiesToSort.OrderByDescending(p => p.Address).ToList(),
            nameof(Property.City) => sortAscending
                ? propertiesToSort.OrderBy(p => p.City).ToList()
                : propertiesToSort.OrderByDescending(p => p.City).ToList(),
            nameof(Property.PropertyType) => sortAscending
                ? propertiesToSort.OrderBy(p => p.PropertyType).ToList()
                : propertiesToSort.OrderByDescending(p => p.PropertyType).ToList(),
            nameof(Property.SquareFeet) => sortAscending
                ? propertiesToSort.OrderBy(p => p.SquareFeet).ToList()
                : propertiesToSort.OrderByDescending(p => p.SquareFeet).ToList(),
            nameof(Property.Status) => sortAscending
                ? propertiesToSort.OrderBy(p => p.Status).ToList()
                : propertiesToSort.OrderByDescending(p => p.Status).ToList(),
            nameof(Property.MonthlyRent) => sortAscending
                ? propertiesToSort.OrderBy(p => p.MonthlyRent).ToList()
                : propertiesToSort.OrderByDescending(p => p.MonthlyRent).ToList(),
            _ => propertiesToSort.OrderBy(p => p.Address).ToList()
        };
    }

    private void SetViewMode(PropertyListViewMode mode)
    {
        viewMode = mode;
    }

    private void StatusFilterChanged(string status)
    {
        statusFilter = status;
        ApplySort();
    }

    private void ClearFilters()
    {
        StatusFilterChanged(string.Empty);
        SearchChanged(string.Empty);
    }

    private void SearchChanged(string term)
    {
        searchTerm = term;
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            ApplySort();
        }
        else
        {
            filteredProperties = filteredProperties
                .Where(p => p.Address.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            p.City.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            p.PropertyType.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void CreateProperty()
    {
        NavigationManager.NavigateTo("/propertymanagement/properties/create");
    }

    private void EditProperty(Guid propertyId)
    {
        NavigationManager.NavigateTo($"/propertymanagement/properties/{propertyId}/edit");
    }

    private void ViewPropertyDetails(Guid propertyId)
    {
        NavigationManager.NavigateTo($"/propertymanagement/properties/{propertyId}");
    }

    private void DeleteProperty(Guid propertyId)
    {
        NavigationManager.NavigateTo($"/propertymanagement/properties/delete/{propertyId}");
    }

    private async Task ShowArchiveModal(Guid id)
    {
        _pendingId = id;
        _cascade = await PropertyService.GetArchiveCascadeSummaryAsync(id);
        _showArchiveModal = true;
    }

    private async Task ShowDeleteModal(Guid id)
    {
        _pendingId = id;
        _cascade = await PropertyService.GetDeleteCascadeSummaryAsync(id);
        _showDeleteModal = true;
    }

    private async Task ConfirmArchive()
    {
        _isProcessing = true;
        await PropertyService.ArchiveAsync(_pendingId);
        _isProcessing = false;
        CloseModals();
        await LoadProperties();
    }

    private async Task ConfirmDelete()
    {
        _isProcessing = true;
        await PropertyService.DeleteAsync(_pendingId);
        _isProcessing = false;
        CloseModals();
        await LoadProperties();
    }

    private async Task UnarchiveProperty(Guid id)
    {
        _pendingId = id;
        _unarchiveSummary = await PropertyService.GetUnarchiveCascadeSummaryAsync(id);
        if (_unarchiveSummary.HasRelatedRecords)
        {
            _showUnarchiveModal = true;
        }
        else
        {
            _isProcessing = true;
            await PropertyService.UnarchivePropertyAsync(id, false);
            _isProcessing = false;
            await LoadProperties();
        }
    }

    private async Task ConfirmUnarchiveAll()
    {
        _isProcessing = true;
        await PropertyService.UnarchivePropertyAsync(_pendingId, true);
        _isProcessing = false;
        CloseModals();
        await LoadProperties();
    }

    private async Task ConfirmUnarchivePropertyOnly()
    {
        _isProcessing = true;
        await PropertyService.UnarchivePropertyAsync(_pendingId, false);
        _isProcessing = false;
        CloseModals();
        await LoadProperties();
    }

    private void CloseModals()
    {
        _showArchiveModal = false;
        _showDeleteModal = false;
        _showUnarchiveModal = false;
        _cascade = null;
        _unarchiveSummary = null;
    }
}