classDiagram
    class BaseModel {
        <<abstract>>
        +Guid Id
        +Guid OrganizationId
        +bool IsDeleted
        +bool IsArchived
        +DateTime CreatedOn
        +string CreatedBy
        +DateTime LastModifiedOn
        +string LastModifiedBy
    }

    class Property {
        +string Address
    }

    class PropertyExpense {
        +Guid PropertyId
        +string ExpenseType
        +string Description
        +decimal Amount
        +string Frequency
        +DateTime EffectiveDate
        +DateTime EndDate
        +string Notes
        +string EndReason
        +Property Property
        +decimal MonthlyAmount
        +bool IsActive
    }

    class BaseServicePropertyExpense {
        <<BaseService~PropertyExpense~>>
        +GetAllAsync() List~PropertyExpense~
        +GetArchivedAsync() List~PropertyExpense~
        +CreateAsync(entity) PropertyExpense
        +UpdateAsync(entity) bool
        +DeleteAsync(id) bool
    }

    class PropertyExpenseService {
        -ApplicationDbContext _context
        -IUserContextService _userContext
        +ValidateEntityAsync(entity) Task
        +GetAllAsync() List~PropertyExpense~
        +GetArchivedAsync() List~PropertyExpense~
        +GetExpensesByPropertyAsync(propertyId) List~PropertyExpense~
        +GetExpensesForLeasePeriodAsync(propertyId, start, end) List~PropertyExpense~
        +GetTotalMonthlyExpensesByPropertyAsync(propertyId) decimal
        +GetTotalMonthlyExpensesByAllPropertiesAsync() Dictionary~Guid, decimal~
        +CancelExpenseAsync(id, reason) Task
        +VoidExpenseAsync(id) Task
    }

    class PropertyExpenseFormModel {
        +Guid PropertyId
        +string ExpenseType
        +string Description
        +decimal Amount
        +string Frequency
        +DateTime EffectiveDate
        +DateTime EndDate
        +string Notes
    }

    class PropertyExpenseList {
        <<Blazor Component>>
        +List~PropertyExpense~ Expenses
        +OnEdit EventCallback
        +OnCancel EventCallback
    }

    class PropertyExpenseModal {
        <<Blazor Component>>
        +PropertyExpenseFormModel Model
        +OnSave EventCallback
    }

    class PropertyExpenseEditModal {
        <<Blazor Component>>
        +PropertyExpense Expense
        +OnSave EventCallback
        +OnCancelExpense EventCallback
    }

    class UserContextService {
        +GetActiveOrganizationIdAsync() Guid
        +GetUserIdAsync() string
    }

    BaseModel <|-- PropertyExpense
    BaseServicePropertyExpense <|-- PropertyExpenseService
    Property "1" --> "many" PropertyExpense : has
    PropertyExpense --> Property : navigation

    PropertyExpenseService ..> UserContextService : uses
    PropertyExpenseService ..> PropertyExpense : manages

    PropertyExpenseList ..> PropertyExpenseService : injects
    PropertyExpenseList --> PropertyExpenseModal : opens
    PropertyExpenseList --> PropertyExpenseEditModal : opens

    PropertyExpenseModal ..> PropertyExpenseFormModel : binds
    PropertyExpenseModal ..> PropertyExpenseService : injects

    PropertyExpenseEditModal ..> PropertyExpense : binds
    PropertyExpenseEditModal ..> PropertyExpenseService : injects
